#!/usr/bin/env bash
set -uo pipefail
source "$(dirname "$0")/env"
cd "$TOOLS_ROOT"
out="$TOOLS_RESULTS/${TOOLS_EVIDENCE_OUT:-evidence}"
only="${1:-}"
evidence=tools/bin/evidence
free_threaded="$TOOLS_RESULTS/free-threaded-venv/bin/python"
host_image="hirefire-python-hosts:3.13-uwsgi"
tls="$TOOLS_RESULTS/tls"
mkdir -p "$out" "$tls"
ls dist/*.whl >/dev/null 2>&1 || poetry build -q
wheel="$(ls dist/*.whl | head -1)"

write() {
  local name="$1"
  if [ -n "$only" ] && [ "$only" != "$name" ]; then
    return 0
  fi
  "$name" >"$out/$name.txt" 2>&1
  echo "$name exit=$? lines=$(wc -l <"$out/$name.txt" | tr -d ' ')"
}

certificate() {
  openssl req -x509 -newkey rsa:2048 -nodes -keyout "$tls/redis.key" -out "$tls/redis.crt" -days 2 \
    -subj "/CN=127.0.0.1" -addext "subjectAltName=IP:127.0.0.1" >/dev/null 2>&1
}

celery_app_cost() {
  $evidence celery_app_cost.py py314-celery 2>/dev/null
}

celery_due_scheduled() {
  $evidence celery_due_scheduled.py py314-celery threads
  local port
  port="$(awk -F= '$1 == "REDIS_PORT" { print $2 }' "$TOOLS_ROOT/.env")"
  docker run --rm -e TOOLS_REDIS_URL="redis://host.docker.internal:$port/14" \
    -v "$TOOLS_ROOT/tools/evidence":/evidence:ro -w /evidence "$host_image" python celery_due_scheduled.py prefork
}

celery_host_app() {
  $evidence celery_host_app.py py314-celery
}

celery_scheduled_reply() {
  $evidence celery_scheduled_reply.py py314-celery 10000
  $evidence celery_scheduled_reply.py py314-celery 100000
}

exit_and_fork_warning() {
  $evidence exit_and_fork_warning.py py314-core
}

lease_steal() {
  $evidence lease_steal.py py314-rq2 python
  if [ -n "${TOOLS_RUBY_ROOT:-}" ]; then
    $evidence lease_steal.py py314-core ruby
  fi
}

performance() {
  $evidence performance.py py314-core contention
  PYTHONPATH="$TOOLS_ROOT:$TOOLS_ROOT/tools/lib" PYTHON_GIL=0 "$free_threaded" -X gil=0 tools/evidence/performance.py contention
  $evidence performance.py py314-core idle worker.1
  $evidence performance.py py314-core idle web.1
}

proc_fork_cpu() {
  docker run --rm -v "$TOOLS_ROOT":/src:ro -e PYTHONPATH=/src python:3.13-bookworm python /src/tools/evidence/proc_fork_cpu.py
}

request_path_cost() {
  $evidence request_path_cost.py py314-core token
  $evidence request_path_cost.py py314-rq2 with_job_library
  $evidence request_path_cost.py py314-core no_token
  $evidence request_path_cost.py py311-core token
}

transport_security() {
  $evidence transport_security.py py314-core certificate "$tls/redis.crt" "$tls/redis.key"
  $evidence transport_security.py py314-core proxy
}

typing_consumer() {
  local consumer="$TOOLS_RESULTS/consumer"
  mkdir -p "$consumer"
  cp tools/evidence/typing_consumer.py "$consumer/"
  "$TOOLS_VENV/bin/pip" install -q --force-reinstall --no-deps "$wheel"
  (
    cd "$consumer"
    echo "== mypy --strict"
    "$TOOLS_VENV/bin/mypy" --strict typing_consumer.py 2>&1 | sed -E 's#[^ ]*site-packages/##'
    echo "== pyright"
    "$TOOLS_VENV/bin/pyright" typing_consumer.py 2>&1 | sed -E 's#[^ ]*/consumer/##' | tail -14
  )
}

case "$only" in "" | transport_security) certificate ;; esac
for name in celery_app_cost celery_due_scheduled celery_host_app celery_scheduled_reply exit_and_fork_warning \
  lease_steal performance proc_fork_cpu request_path_cost transport_security typing_consumer; do
  write "$name"
done
