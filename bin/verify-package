#!/usr/bin/env python3
import sys
import tarfile
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DIST = ROOT / "dist"


def has_suffix(names, suffix):
    return any(n.endswith(suffix) for n in names)


def has_name(names, name):
    return any(n.split("/")[-1] == name for n in names)


def require(condition, message, names):
    if not condition:
        sys.exit(f"{message}\npacked: {sorted(names)}")


def forbidden_paths(names):
    bad = []
    for name in names:
        parts = name.replace("\\", "/").split("/")
        if any(part in {"AGENTS.md", ".env", ".venv", ".tox", "tests"} for part in parts):
            bad.append(name)
    return bad


def project_version():
    for line in (ROOT / "pyproject.toml").read_text().splitlines():
        if line.startswith("version ="):
            return line.split("=", 1)[1].strip().strip("\"'")
    sys.exit("could not read version from pyproject.toml")


def metadata_version(text: str) -> str:
    for line in text.splitlines():
        if line.lower().startswith("version:"):
            return line.split(":", 1)[1].strip()
    sys.exit("artifact metadata has no Version field")


def main():
    if not DIST.is_dir():
        sys.exit("no dist/; run poetry build first")

    version = project_version()
    sdist = DIST / f"hirefire_resource-{version}.tar.gz"
    if not sdist.is_file():
        sys.exit(f"no sdist for {version} in dist/ (expected {sdist.name})")
    with tarfile.open(sdist, "r:gz") as tf:
        sdist_names = tf.getnames()
        pkg_info = next((n for n in sdist_names if n.endswith("PKG-INFO")), None)
        if pkg_info is None:
            sys.exit("sdist missing PKG-INFO")
        member = tf.extractfile(pkg_info)
        if member is None:
            sys.exit("sdist PKG-INFO unreadable")
        packed_version = metadata_version(member.read().decode("utf-8", "replace"))
    if packed_version != version:
        sys.exit(f"sdist metadata version {packed_version} != {version}")
    require(has_name(sdist_names, "CHANGELOG.md"), "sdist missing CHANGELOG.md", sdist_names)
    require(has_name(sdist_names, "LICENSE"), "sdist missing LICENSE", sdist_names)
    require(has_name(sdist_names, "README.md"), "sdist missing README.md", sdist_names)
    require(
        has_suffix(sdist_names, "hirefire_resource/py.typed"),
        "sdist missing hirefire_resource/py.typed",
        sdist_names,
    )
    sdist_forbidden = forbidden_paths(sdist_names)
    require(not sdist_forbidden, "sdist packed forbidden path(s)", sdist_forbidden)
    print("sdist ok:", sdist.name)

    wheel = DIST / f"hirefire_resource-{version}-py3-none-any.whl"
    if not wheel.is_file():
        sys.exit(f"no wheel for {version} in dist/ (expected {wheel.name})")
    with zipfile.ZipFile(wheel) as zf:
        wheel_names = zf.namelist()
        meta_name = next((n for n in wheel_names if n.endswith(".dist-info/METADATA")), None)
        if meta_name is None:
            sys.exit("wheel missing METADATA")
        packed_version = metadata_version(zf.read(meta_name).decode("utf-8", "replace"))
    if packed_version != version:
        sys.exit(f"wheel metadata version {packed_version} != {version}")
    require(
        has_suffix(wheel_names, "hirefire_resource/py.typed"),
        "wheel missing hirefire_resource/py.typed",
        wheel_names,
    )
    require(has_name(wheel_names, "README.md"), "wheel missing README.md", wheel_names)
    require(has_name(wheel_names, "CHANGELOG.md"), "wheel missing CHANGELOG.md", wheel_names)
    require(
        any("LICENSE" in name for name in wheel_names),
        "wheel missing LICENSE",
        wheel_names,
    )
    wheel_forbidden = forbidden_paths(wheel_names)
    require(not wheel_forbidden, "wheel packed forbidden path(s)", wheel_forbidden)
    print("wheel ok:", wheel.name)


if __name__ == "__main__":
    main()
